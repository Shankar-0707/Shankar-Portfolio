# .env.local

# Replace these values with your actual Gmail account and App Password
# NEVER commit the real .env.local file to GitHub!

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# GitHub Personal Access Token (classic) — public_repo read scope only
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_pat_here

# Keep existing configs below
NEXT_DISABLE_TURBOPACK=1
